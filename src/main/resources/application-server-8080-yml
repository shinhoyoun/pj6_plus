spring:
  datasource:
    url: jdbc:mysql://localhost:3306/pj6_plus
    username: root
    password: 12345678
    driver-class-name: com.mysql.cj.jdbc.Driver

  jpa:
    show-sql: true
    hibernate:
      ddl-auto: update
    properties:
      hibernate:
        format_sql: true
    defer-datasource-initialization: true

  data:
    redis:
      host: 127.0.0.1
      port: 6379

  servlet:
    multipart:
      max-file-size: 100MB
      max-request-size: 100MB

  jmx:
    enabled: false

server:
  port: 8080   # 기본 포트



